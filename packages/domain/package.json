{
  "name": "@racer/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Uma Racer game rules: shared types and pure progression formulas (see docs/design).",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "./master": {
      "require": { "types": "./dist/cjs/master/index.d.ts", "default": "./dist/cjs/master/index.js" },
      "default": { "types": "./src/master/index.ts", "default": "./src/master/index.ts" }
    },
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./save": {
      "require": {
        "types": "./dist/cjs/save/index.d.ts",
        "default": "./dist/cjs/save/index.js"
      },
      "default": {
        "types": "./src/save/index.ts",
        "default": "./src/save/index.ts"
      }
    },
    "./state": {
      "require": {
        "types": "./dist/cjs/state/index.d.ts",
        "default": "./dist/cjs/state/index.js"
      },
      "default": {
        "types": "./src/state/index.ts",
        "default": "./src/state/index.ts"
      }
    },
    "./economy": {
      "require": {
        "types": "./dist/cjs/economy/index.d.ts",
        "default": "./dist/cjs/economy/index.js"
      },
      "default": {
        "types": "./src/economy/index.ts",
        "default": "./src/economy/index.ts"
      }
    },
    "./tiers": {
      "require": {
        "types": "./dist/cjs/tiers/index.d.ts",
        "default": "./dist/cjs/tiers/index.js"
      },
      "default": {
        "types": "./src/tiers/index.ts",
        "default": "./src/tiers/index.ts"
      }
    },
    "./items": {
      "require": {
        "types": "./dist/cjs/items/index.d.ts",
        "default": "./dist/cjs/items/index.js"
      },
      "default": {
        "types": "./src/items/index.ts",
        "default": "./src/items/index.ts"
      }
    },
    "./work": {
      "require": {
        "types": "./dist/cjs/work/index.d.ts",
        "default": "./dist/cjs/work/index.js"
      },
      "default": {
        "types": "./src/work/index.ts",
        "default": "./src/work/index.ts"
      }
    },
    "./farm": {
      "require": {
        "types": "./dist/cjs/farm/index.d.ts",
        "default": "./dist/cjs/farm/index.js"
      },
      "default": {
        "types": "./src/farm/index.ts",
        "default": "./src/farm/index.ts"
      }
    },
    "./training": {
      "require": {
        "types": "./dist/cjs/training/index.d.ts",
        "default": "./dist/cjs/training/index.js"
      },
      "default": {
        "types": "./src/training/index.ts",
        "default": "./src/training/index.ts"
      }
    },
    "./check-in": {
      "require": {
        "types": "./dist/cjs/check-in/index.d.ts",
        "default": "./dist/cjs/check-in/index.js"
      },
      "default": {
        "types": "./src/check-in/index.ts",
        "default": "./src/check-in/index.ts"
      }
    },
    "./planner": {
      "require": {
        "types": "./dist/cjs/planner/index.d.ts",
        "default": "./dist/cjs/planner/index.js"
      },
      "default": {
        "types": "./src/planner/index.ts",
        "default": "./src/planner/index.ts"
      }
    },
    "./sim": {
      "require": {
        "types": "./dist/cjs/sim/index.d.ts",
        "default": "./dist/cjs/sim/index.js"
      },
      "default": {
        "types": "./src/sim/index.ts",
        "default": "./src/sim/index.ts"
      }
    },
    "./builds": {
      "require": {
        "types": "./dist/cjs/builds/index.d.ts",
        "default": "./dist/cjs/builds/index.js"
      },
      "default": {
        "types": "./src/builds/index.ts",
        "default": "./src/builds/index.ts"
      }
    },
    "./hub": {
      "require": {
        "types": "./dist/cjs/hub/index.d.ts",
        "default": "./dist/cjs/hub/index.js"
      },
      "default": {
        "types": "./src/hub/index.ts",
        "default": "./src/hub/index.ts"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "docs:update": "UPDATE_DOCS=1 vitest run src/docs"
  },
  "devDependencies": {
    "@luismlorenzana/uma-art": "2.7.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@luismlorenzana/uma-data": "1.1.0",
    "@luismlorenzana/uma-work": "0.1.0"
  }
}
