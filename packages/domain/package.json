{
  "name": "@racer/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Uma Racer game rules: shared types and pure progression formulas (see docs/design).",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./master": {
      "require": {
        "types": "./dist/cjs/master/index.d.ts",
        "default": "./dist/cjs/master/index.js"
      },
      "default": {
        "types": "./src/master/index.ts",
        "default": "./src/master/index.ts"
      }
    },
    "./save": {
      "require": {
        "types": "./dist/cjs/save/index.d.ts",
        "default": "./dist/cjs/save/index.js"
      },
      "default": {
        "types": "./src/save/index.ts",
        "default": "./src/save/index.ts"
      }
    },
    "./account": {
      "require": {
        "types": "./dist/cjs/account/index.d.ts",
        "default": "./dist/cjs/account/index.js"
      },
      "default": {
        "types": "./src/account/index.ts",
        "default": "./src/account/index.ts"
      }
    },
    "./career": {
      "require": {
        "types": "./dist/cjs/career/index.d.ts",
        "default": "./dist/cjs/career/index.js"
      },
      "default": {
        "types": "./src/career/index.ts",
        "default": "./src/career/index.ts"
      }
    },
    "./build": {
      "require": {
        "types": "./dist/cjs/build/index.d.ts",
        "default": "./dist/cjs/build/index.js"
      },
      "default": {
        "types": "./src/build/index.ts",
        "default": "./src/build/index.ts"
      }
    },
    "./stages": {
      "require": {
        "types": "./dist/cjs/stages/index.d.ts",
        "default": "./dist/cjs/stages/index.js"
      },
      "default": {
        "types": "./src/stages/index.ts",
        "default": "./src/stages/index.ts"
      }
    },
    "./tiers": {
      "require": {
        "types": "./dist/cjs/tiers/index.d.ts",
        "default": "./dist/cjs/tiers/index.js"
      },
      "default": {
        "types": "./src/tiers/index.ts",
        "default": "./src/tiers/index.ts"
      }
    },
    "./hub": {
      "require": {
        "types": "./dist/cjs/hub/index.d.ts",
        "default": "./dist/cjs/hub/index.js"
      },
      "default": {
        "types": "./src/hub/index.ts",
        "default": "./src/hub/index.ts"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "docs:update": "UPDATE_DOCS=1 vitest run src/docs"
  },
  "devDependencies": {
    "@luismlorenzana/uma-art": "2.10.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@luismlorenzana/uma-data": "1.1.0"
  }
}
