{
  "name": "@racer/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Uma Racer game rules: shared types and pure progression formulas (see docs/design).",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./farm": {
      "require": {
        "types": "./dist/cjs/farm/index.d.ts",
        "default": "./dist/cjs/farm/index.js"
      },
      "default": {
        "types": "./src/farm/index.ts",
        "default": "./src/farm/index.ts"
      }
    },
    "./farm/kitchen": {
      "require": {
        "types": "./dist/cjs/farm/kitchen/index.d.ts",
        "default": "./dist/cjs/farm/kitchen/index.js"
      },
      "default": {
        "types": "./src/farm/kitchen/index.ts",
        "default": "./src/farm/kitchen/index.ts"
      }
    },
    "./puzzles/*": {
      "require": {
        "types": "./dist/cjs/minigames/uma-puzzles/*.d.ts",
        "default": "./dist/cjs/minigames/uma-puzzles/*.js"
      },
      "default": {
        "types": "./src/minigames/uma-puzzles/*.ts",
        "default": "./src/minigames/uma-puzzles/*.ts"
      }
    },
    "./hub": {
      "require": {
        "types": "./dist/cjs/hub/index.d.ts",
        "default": "./dist/cjs/hub/index.js"
      },
      "default": {
        "types": "./src/hub/index.ts",
        "default": "./src/hub/index.ts"
      }
    },
    "./rework/*": {
      "require": {
        "types": "./dist/cjs/rework/*/index.d.ts",
        "default": "./dist/cjs/rework/*/index.js"
      },
      "default": {
        "types": "./src/rework/*/index.ts",
        "default": "./src/rework/*/index.ts"
      }
    },
    "./save-g2": {
      "require": {
        "types": "./dist/cjs/save-g2/index.d.ts",
        "default": "./dist/cjs/save-g2/index.js"
      },
      "default": {
        "types": "./src/save-g2/index.ts",
        "default": "./src/save-g2/index.ts"
      }
    },
    "./puzzles-content-fixtures": "./src/minigames/uma-puzzles/content.synthetic.ts",
    "./puzzles-preservation-fixtures": "./src/minigames/uma-puzzles/preservation.synthetic.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "docs:update": "UPDATE_DOCS=1 vitest run src/docs"
  },
  "devDependencies": {
    "@luismlorenzana/uma-art": "2.4.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@luismlorenzana/uma-data": "1.0.0"
  }
}
