{
  "name": "uma-racer",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Uma Musume-inspired racing RPG — monorepo (web + api + domain + race engine).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web": "pnpm --filter @racer/web dev",
    "api": "pnpm --filter @racer/api start:dev",
    "data:import": "pnpm --filter @racer/data-pipeline run import",
    "assets:import": "pnpm --filter @racer/asset-pipeline run import",
    "content:publish": "pnpm --filter @racer/data-pipeline run publish",
    "data:rpg:import": "pnpm --filter @racer/data-pipeline run rpg:import",
    "data:rpg:validate": "pnpm --filter @racer/data-pipeline run rpg:validate",
    "assets:rpg:import": "pnpm --filter @racer/asset-pipeline run rpg:import",
    "sim:balance": "pnpm dlx tsx scripts/sim/strategy-balance.ts",
    "sim:constellation": "pnpm dlx tsx scripts/sim/constellation-balance.ts",
    "sim:careers": "pnpm dlx tsx scripts/sim/career-balance.ts",
    "sim:turns": "pnpm dlx tsx scripts/sim/turn-balance.ts",
    "assets:bust-sheet": "pnpm --filter @racer/asset-pipeline run bust-sheet",
    "sim:training": "pnpm dlx tsx scripts/sim/training-balance.ts",
    "sim:spark": "pnpm dlx tsx scripts/sim/spark-balance.ts",
    "sim:farm": "pnpm --filter @racer/data-pipeline exec node --import tsx ../sim/farm-progression.ts",
    "sim:rpg:progression": "pnpm --filter @racer/data-pipeline exec node --import tsx ../sim/rpg-progression.ts",
    "sim:rpg:combat": "pnpm --filter @racer/data-pipeline exec node --import tsx ../sim/rpg-combat.ts",
    "sim:rpg:campaign": "pnpm --filter @racer/data-pipeline exec node --import tsx ../sim/rpg-campaign.ts",
    "sim:puzzles": "pnpm --filter @racer/data-pipeline exec node --import tsx ../sim/puzzles.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "protobufjs",
      "@firebase/util",
      "sharp"
    ]
  }
}
