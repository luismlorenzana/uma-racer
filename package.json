{
  "name": "uma-racer",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Uma Musume-inspired racing RPG — monorepo (web + api + domain + race engine).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node --test scripts/check-size.test.mjs && turbo run test && pnpm sim:careers -- --synthetic && pnpm sim:stages -- --synthetic",
    "web": "pnpm --filter @racer/web dev",
    "api": "pnpm --filter @racer/api start:dev",
    "overlays:import": "pnpm --filter @racer/overlays run import",
    "overlays:publish": "pnpm --filter @racer/overlays run publish",
    "master:parity": "pnpm --filter @racer/overlays run parity",
    "sim:balance": "pnpm dlx tsx scripts/sim/strategy-balance.ts",
    "sim:decks": "pnpm dlx tsx scripts/sim/decks.ts",
    "sim:careers": "pnpm --filter @racer/overlays exec tsx ../sim/careers.ts",
    "sim:stages": "pnpm --filter @racer/overlays exec tsx ../sim/stages.ts",
    "docs:update": "pnpm --filter @racer/domain run docs:update",
    "test:ci": "node --test scripts/check-size.test.mjs && turbo run test --concurrency=1 && pnpm sim:careers -- --synthetic && pnpm sim:stages -- --synthetic"
  },
  "devDependencies": {
    "turbo": "^2.10.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "protobufjs",
      "@firebase/util",
      "sharp"
    ]
  }
}
