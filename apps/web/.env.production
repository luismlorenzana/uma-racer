# Production build config for the SPA (used by `vite build`).
# Firebase web values are PUBLIC client config (safe to ship in the bundle); real security is the API's
# Firebase-token auth guard + email allowlist. Fill these in after the GCP bootstrap
# (docs/technical/infrastructure.md#one-time-bootstrap-run-by-the-owner). Empty values keep auth disabled.
VITE_API_BASE_URL=
# Use the Hosting domain so the auth handler is same-origin inside the iOS Home Screen app.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
