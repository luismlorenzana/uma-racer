# Backend config. Copy to .env for local dev.
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Saves: "local" (JSON file, no cloud) or "firestore" (g3/{uid}). The local file holds generation 3's save (D381).
PERSISTENCE=local
LOCAL_SAVE_FILE=.data/save-g3.json

# Auth: "disabled" for local dev, or leave unset to require a verified Firebase token
AUTH_MODE=disabled
# ALLOWED_EMAIL=you@example.com     # owner allowlist (when auth is on)

# Dev operations (`dev-grant`): `pnpm dev` starts the API with DEV_OPERATIONS=true. No deploy ever sets it.
# DEV_OPERATIONS=true

# Private content packs + atlases: "local" (gitignored folder) or "gcs" (private bucket)
CONTENT_SOURCE=local
CONTENT_DIR=../../content
# CONTENT_BUCKET=uma-racer-content
